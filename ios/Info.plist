<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(CMS_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSpokenName</key>
	<string>$(CMS_SPOKEN_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CMSDefaultServer</key>
	<string>$(CMS_DEFAULT_SERVER)</string>
	<key>CMSSignInTitle</key>
	<string>$(CMS_SIGNIN_TITLE)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>The camera scans documents (releases, authorizations) straight to a client's file.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Face ID keeps your client records locked to you.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>The microphone lets you run the app hands-free with the voice assistant.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Lets you save a client document image to your photo library when you choose Save Image while viewing it.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Speech recognition turns what you say into case-management actions, hands-free. Your speech is recognized on this iPhone when it supports that; otherwise the audio is sent to Apple to be transcribed.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
